{
  "name": "launchpad-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first command center for all your projects. One service, many faces.",
  "type": "module",
  "author": "Mikkel",
  "//main": "Entry point for the packaged Electron shell. Unpackaged runs name the file directly (`npm run desktop`); a packaged app has only this field to go on.",
  "main": "electron/main.cjs",
  "bin": {
    "launchpad": "cli/launchpad.mjs"
  },
  "scripts": {
    "server": "tsx watch src/server/index.ts",
    "server:once": "tsx src/server/index.ts",
    "web": "vite",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:server\" \"npm:web\"",
    "dev:app": "concurrently -k -n server,web,shell -c blue,magenta,green \"npm:server\" \"npm:web\" \"npm:desktop:dev\"",
    "stop": "node scripts/stop.mjs",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "electron electron/main.cjs --dev",
    "icons": "node scripts/make-icon.mjs",
    "shortcuts": "node scripts/make-shortcuts.mjs",
    "bake": "node scripts/bake-app-dir.mjs",
    "pack": "npm run build && npm run bake && electron-builder --win --dir",
    "dist": "npm run build && npm run bake && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "cli": "node cli/launchpad.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
